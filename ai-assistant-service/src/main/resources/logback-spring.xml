<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="AI_TRACE_FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/ai-agent-trace.json</file>
        <append>true</append>
        <encoder>
            <pattern>%msg%n%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="AI_AGENT_TRACE" level="INFO" additivity="false">
        <appender-ref ref="AI_TRACE_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
