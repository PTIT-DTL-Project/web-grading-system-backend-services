<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="AI_TRACE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/ai-agent-trace.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/ai-agent-trace.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%msg%n%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="AI_AGENT_TRACE" level="INFO" additivity="false">
        <appender-ref ref="AI_TRACE_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
