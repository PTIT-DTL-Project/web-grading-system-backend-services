            "config": {
              "method": "POST",
              "path": "/api/v1/appointments",
              "body": {
                "status": "Dang cho",
                "doctorId": "${doctorId}",
                "patientId": "${patientId}",
                "appointmentDate": "2026-11-05"
              },
              "expected_status": 201,
              "assertions": [
                {
                  "kind": "status",
                  "equals": 201
                },
                {
                  "kind": "json_path",
                  "path": "$.id",
                  "exists": true
                },
                {
                  "kind": "json_path",
                  "path": "$.doctorId",
                  "exists": true
                },
                {
                  "kind": "json_path",
                  "path": "$.patientId",
                  "exists": true
                }
              ],
              "extract": [
                {
                  "name": "appointmentId",
                  "from": "response_body",
                  "expression": "$.id"
                }
              ],
              "timeoutMs": 5000
            },
            "weight": 1,
            "required": true
          },
          {
            "stepOrder": 3,
            "name": "Lấy lịch hẹn (kiểm tra liên kết FK)",
            "stepType": "HTTP_REQUEST",
            "config": {
              "method": "GET",
              "path": "/api/v1/appointments/${appointmentId}",
              "expected_status": 200,
              "assertions": [
                {
                  "kind": "status",
                  "equals": 200
                },
                {
                  "kind": "json_path",
                  "path": "$.id",
                  "exists": true
                },
                {
                  "kind": "field_equals",
                  "path": "$.doctorId",
                  "equals": "${doctorId}"
                },
                {
                  "kind": "field_equals",
                  "path": "$.patientId",
                  "equals": "${patientId}"
