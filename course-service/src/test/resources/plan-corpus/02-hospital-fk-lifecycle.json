          "name": "Lịch hẹn khám — Tích hợp bác sĩ & bệnh nhân",
          "description": "Tạo bác sĩ, bệnh nhân, lập lịch hẹn liên kết FK; kiểm tra toàn bộ vòng đời CRUD và toàn vẹn DB",
          "sequenceOrder": 1,
          "weight": 15
        },
        "steps": [
          {
            "stepOrder": 0,
            "name": "Tạo bác sĩ",
            "stepType": "HTTP_REQUEST",
            "config": {
              "method": "POST",
