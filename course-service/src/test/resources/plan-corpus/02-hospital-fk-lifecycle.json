              "body": {
                "name": "Bac si Test",
                "phone": "0901234567",
                "specialization": "Tim mach"
              },
              "expected_status": 201,
              "assertions": [
                {
                  "kind": "status",
                  "equals": 201
                },
                {
                  "kind": "json_path",
                  "path": "$.id",
                  "exists": true
                }
              ],
              "extract": [
                {
                  "name": "doctorId",
                  "from": "response_body",
                  "expression": "$.id"
                }
              ],
              "timeoutMs": 5000
            },
            "weight": 1,
            "required": true
          },
          {
            "stepOrder": 1,
            "name": "Tạo bệnh nhân",
            "stepType": "HTTP_REQUEST",
            "config": {
              "method": "POST",
              "path": "/api/v1/patients",
              "body": {
                "dob": "1990-05-15",
                "phone": "0987654321",
                "fullName": "Ben nhan Test"
              },
              "expected_status": 201,
              "assertions": [
                {
                  "kind": "status",
                  "equals": 201
                },
                {
                  "kind": "json_path",
                  "path": "$.id",
                  "exists": true
                }
              ],
              "extract": [
                {
                  "name": "patientId",
                  "from": "response_body",
                  "expression": "$.id"
                }
