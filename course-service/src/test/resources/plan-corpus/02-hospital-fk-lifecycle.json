              ],
              "timeoutMs": 5000
            },
            "weight": 1,
            "required": true
          },
          {
            "stepOrder": 4,
            "name": "Kiểm tra liên kết FK qua JOIN",
            "stepType": "DB_QUERY",
            "config": {
              "connection": {
                "db_type": "postgres",
                "db_service": "db",
                "db_port": 5432,
                "database": "hospital_db",
                "username": "postgres",
                "password": "postgres"
              },
              "query": "SELECT a.id FROM appointments a INNER JOIN doctors d ON a.doctor_id = d.id INNER JOIN patients p ON a.patient_id = p.id WHERE a.id = '${appointmentId}'",
              "expected": {
                "row_count": 1
              },
              "timeoutMs": 30000
            },
            "weight": 1,
            "required": true
          },
          {
            "stepOrder": 5,
            "name": "Cập nhật trạng thái khám",
            "stepType": "HTTP_REQUEST",
            "config": {
              "method": "PATCH",
              "path": "/api/v1/appointments/${appointmentId}",
              "body": {
                "status": "Da kham"
              },
              "expected_status": 200,
              "assertions": [
                {
                  "kind": "status",
                  "equals": 200
                },
                {
                  "kind": "contains",
                  "text": "Da kham"
                }
              ],
              "timeoutMs": 5000
            },
            "weight": 1,
            "required": true
          }
        ]
      }
