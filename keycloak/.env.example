# Local throwaway stack for src-services/keycloak/docker-compose.yml — copy nothing,
# this file documents keys only. Real values live in the gitignored repo-root
# .env (shared with the stack via env_file: ../../.env); export it first:
#   set -a; source ../../.env; set +a   (from src-services/keycloak/)
#   # or from the repo root: set -a; source .env; set +a
#
# Required (no usable defaults):
#   KEYCLOAK_DB_URL         e.g. jdbc:postgresql://<neon-host>/keycloak?sslmode=require
#   KEYCLOAK_DB_USERNAME
#   KEYCLOAK_DB_PASSWORD
#
# Optional (default "admin" — fine for a throwaway local stack, never production):
#   KEYCLOAK_ADMIN_USERNAME
#   KEYCLOAK_ADMIN_PASSWORD
#
# Everything the api-gateway service needs also comes from the same root .env
# (KEYCLOAK_ISSUER_URI is overridden to http://keycloak:8080/... in compose).
