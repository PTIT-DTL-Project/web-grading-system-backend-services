# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ---- Traefik NodePort / Gateway ----------------------------------------------
GATEWAY_PORT=8080

# ---- Microservices Database (PostgreSQL / Neon DB) ---------------------------
# Default fallback values for Spring Boot microservices
JDBC_URL=jdbc:postgresql://<db-host>:5432/<db-name>?sslmode=require
DB_HOST=<db-host>
DB_PORT=5432
DB_NAME=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=<db-password>

# ---- Keycloak IAM & Database -------------------------------------------------
# KC_DB_URL: Connection string for Keycloak database
# When deploying to K8s or running Keycloak against Neon DB:
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/ptit-wgs
KEYCLOAK_DB_URL=jdbc:postgresql://ep-frosty-hill-ayd5wchg-pooler.c-5.us-east-2.aws.neon.tech:5432/keycloak?sslmode=require
KEYCLOAK_DB_USERNAME=neondb_owner
KEYCLOAK_DB_PASSWORD=<keycloak-db-password>

# Keycloak Bootstrap Admin Account
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<keycloak-admin-password>

# ---- RustFS / MinIO (Object Storage) -----------------------------------------
RUSTFS_ENDPOINT=https://web-dev1-rustfs-api.vucongtuanduong.dpdns.org
RUSTFS_PUBLIC_ENDPOINT=https://web-dev1-rustfs-api.vucongtuanduong.dpdns.org
RUSTFS_ACCESS_KEY=<storage-access-key>
RUSTFS_SECRET_KEY=<storage-secret-key>
RUSTFS_BUCKET_NAME=submission-files

# ---- Submission Service ------------------------------------------------------
PRESIGNED_URL_EXPIRY_MINUTES=15

# ---- Kafka (Aiven, SASL_SSL) -------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=wc-test-truonggiang.g.aivencloud.com:23886
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=<kafka-password>
KAFKA_CA_PATH=submission-service/docker/kafka-ca.pem
KAFKA_SECURITY_PROTOCOL=SASL_SSL
SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_SSL

# ---- Service URLs (Service-to-Service communication) -------------------------
COURSE_SERVICE_URI=http://localhost:8081
COURSE_SERVICE_URL=http://localhost:8081
SUBMISSION_SERVICE_URI=http://localhost:8082
SUBMISSION_SERVICE_URL=http://localhost:8082
RESULT_SERVICE_URI=http://localhost:8084
RESULT_SERVICE_URL=http://localhost:8084
